# Secure (HTTPS-only) cookies; defaults to true in production
COOKIE_SECURE="false"

# Playback Authorization Token Signing Secret (HMAC-SHA256)
PLAYBACK_TOKEN_SECRET="cinevide-dev-playback-token-secret-change-in-prod"

# Forwarding proxy headers trust (false for local dev, auto-detected on Vercel)
TRUST_PROXY_HEADERS="false"

# Append playback token to direct HLS URLs for edge proxy validation
PLAYBACK_URL_TOKEN="false"

# Optional: signed playback for licensed streams (leave unset if not used)
# MUX_SIGNING_KEY_ID=""
# MUX_PRIVATE_KEY=""
# CLOUDFLARE_STREAM_KEY_ID=""
# CLOUDFLARE_STREAM_PEM=""
# CLOUDFLARE_STREAM_CUSTOMER_CODE=""
